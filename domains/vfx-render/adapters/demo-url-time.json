{
  "schema": "closed-loop-adapter/3",
  "domain": "vfx-render",
  "topic": "url-time 冻帧 + 扁平参数（flat-params）宿主示例：页面按 ?time=<秒> 自冻，没有 window.step；宿主页面不在包内",
  "packageNote": "格式示例：url-time 冻帧 + flat-params 改参。clientRoot 用 %VFX_LOOP_DEMO_HOST% 模板（= 那个 demo 宿主页面所在目录，包里不带它）；不设这个变量时本份 runnable=false，但 parse 仍然成立，用来示范两种协议/两种改参形态。",
  "name": "trial-demo-url-time",
  "clientRoot": "%VFX_LOOP_DEMO_HOST%",
  "config": {
    "path": "trial-params.json",
    "block": "effects.FireRay.demo",
    "format": "flat-params",
    "note": "P2.6 新增形态：宿主不是 vfx.json 里 effects.<E>.<B>，而是一份扁平 {params:{...}} 的 json —— 走 apply_params.js。block 字段对 flat 形态只用于日志（不参与取参）。"
  },
  "page": {
    "file": "index.html",
    "query": "?panel=0&hud=0&time={sec}",
    "readyExpr": "String(!!(window.__ready === true && window.__cfgLoaded === true && document.readyState === \"complete\"))",
    "readbackExpr": "JSON.stringify(window.__demoP())"
  },
  "freeze": {
    "protocol": "url-time",
    "clock": "n/a",
    "targetTimeMs": 900,
    "seed": 12345,
    "urlTemplate": "index.html?panel=0&hud=0&time={sec}",
    "verify": "strict",
    "note": "试刀 demo 页那种：frozenTime 由 ?time=<秒> 一次性决定，没有推进过程 -> clock 恒为 n/a、步长 0。verify=strict 会在首次进来时同一 URL 连拍两张，逐字节比，比不过就报错（防止页面无视 ?time= 还在跑动画）。"
  },
  "target": {
    "mode": "default",
    "note": "P2.6 target.mode=default：不 patch 任何参数（= trial-params.json 的现值）+ 当前冻帧时刻 ?time=0.9 渲一张当目标。"
  },
  "params": {
    "mode": "list",
    "list": ["bristle=2.2", "flow=1.6"],
    "note": "试刀 demo 的两个活旋钮（bristle/flow），显式给起跑值以便与 default 目标拉开距离。"
  },
  "render": {
    "tier": "low",
    "width": 640,
    "height": 360
  },
  "server": {
    "staticPort": 8290,
    "cdpPort": 9490,
    "browserProfilePrefix": "prof_p26_demo_",
    "staticScript": "../static/server.mjs",
    "bind": "127.0.0.1"
  },
  "browser": {
    "exe": "",
    "exeCandidates": [
      "%ProgramFiles(x86)%\\Microsoft\\Edge\\Application\\msedge.exe",
      "%ProgramFiles%\\Microsoft\\Edge\\Application\\msedge.exe"
    ],
    "args": [
      "--headless=new",
      "--no-first-run",
      "--no-default-browser-check",
      "--disable-extensions",
      "--hide-scrollbars",
      "--mute-audio",
      "--disable-gpu-vsync",
      "--enable-unsafe-swiftshader",
      "--use-gl=angle",
      "--use-angle=swiftshader",
      "--force-device-scale-factor=1",
      "--window-size={width},{height}",
      "--remote-debugging-port={cdpPort}",
      "--user-data-dir={profile}",
      "about:blank"
    ]
  },
  "metrics": [
    { "id": "cov", "extract": "cov", "opts": { "luma": 40 }, "norm": { "mode": "range", "range": [0, 0.3] }, "weight": 0.35 },
    { "id": "lapVar", "extract": "lapVar", "opts": { "luma": 40 }, "norm": { "mode": "range", "range": [200, 4000] }, "weight": 0.35 },
    { "id": "tone", "extract": "warmFrac", "opts": { "luma": 80, "rMin": 140, "rg": 1.15, "gb": 0.9 }, "norm": { "mode": "range", "range": [0, 0.55] }, "weight": 0.3 }
  ],
  "score": {
    "type": "l1",
    "penalties": [
      { "id": "coreGone", "when": "ratioCore <= 0 || covCore < 0.5 * T.covCore", "add": 0.5 }
    ]
  },
  "tools": {
    "metricsJs": "metrics2.js",
    "capture": "capture.mjs",
    "apply": "apply_params.js"
  },
  "retarget": {
    "note": "url-time 协议宿主（试刀 demo 页的副本，放在 T4\\hosts\\demo-url-time 里，与 _资产 原件逐字节相同但完全隔离）。_资产 原件零字节改动。"
  }
}

{
  "schema": "closed-loop-adapter/3",
  "name": "fanren-lab",
  "clientRoot": "%VFX_LOOP_CLIENT%",
  "config": {
    "path": "resource/lab/vfx/vfx.json",
    "block": "effects.FireRay.fireBeamG1M1",
    "format": "vfx-block"
  },
  "page": {
    "file": "_dev/mergeProbe.html",
    "query": "?seed={seed}",
    "readyExpr": "String(!!(window.__ready === true && window.__t3_stale === undefined && document.readyState === \"complete\"))"
  },
  "freeze": {
    "protocol": "noloop-step",
    "clock": "virtual",
    "stepMs": 16,
    "targetTimeMs": 320,
    "seed": 12345
  },
  "target": {
    "mode": "params",
    "params": {
      "widthPx": 30,
      "distM": 8.0
    },
    "note": "v3 缺省目标：等价于旧的 -Target targets\\GC.json"
  },
  "params": {
    "mode": "list",
    "list": [
      "widthPx",
      "distM"
    ],
    "note": "v3 缺省白名单：等价于旧的 -Params widthPx,distM"
  },
  "render": {
    "tier": "low",
    "width": 640,
    "height": 360
  },
  "server": {
    "staticPort": 8290,
    "cdpPort": 9490,
    "browserProfilePrefix": "prof_p26_def_",
    "staticScript": "..\\static\\server.mjs",
    "bind": "127.0.0.1"
  },
  "browser": {
    "exe": "",
    "exeCandidates": [
      "%ProgramFiles(x86)%\\Microsoft\\Edge\\Application\\msedge.exe",
      "%ProgramFiles%\\Microsoft\\Edge\\Application\\msedge.exe",
      "%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe",
      "%LOCALAPPDATA%\\Google\\Chrome\\Application\\chrome.exe"
    ],
    "args": [
      "--headless=new",
      "--no-first-run",
      "--no-default-browser-check",
      "--disable-extensions",
      "--hide-scrollbars",
      "--mute-audio",
      "--disable-gpu-vsync",
      "--enable-unsafe-swiftshader",
      "--use-gl=angle",
      "--use-angle=swiftshader",
      "--force-device-scale-factor=1",
      "--window-size={width},{height}",
      "--remote-debugging-port={cdpPort}",
      "--user-data-dir={profile}",
      "about:blank"
    ]
  },
  "metrics": [
    {
      "id": "cov",
      "extract": "cov",
      "opts": {
        "luma": 40
      },
      "norm": {
        "mode": "range",
        "range": [
          0,
          0.3
        ]
      },
      "weight": 0.35
    },
    {
      "id": "lapVar",
      "extract": "lapVar",
      "opts": {
        "luma": 40
      },
      "norm": {
        "mode": "range",
        "range": [
          200,
          4000
        ]
      },
      "weight": 0.35
    },
    {
      "id": "tone",
      "extract": "warmFrac",
      "opts": {
        "luma": 80,
        "rMin": 140,
        "rg": 1.15,
        "gb": 0.9
      },
      "norm": {
        "mode": "range",
        "range": [
          0,
          0.55
        ]
      },
      "weight": 0.3
    }
  ],
  "score": {
    "type": "l1",
    "penalties": [
      {
        "id": "coreGone",
        "when": "ratioCore <= 0 || covCore < 0.5 * T.covCore",
        "add": 0.5
      }
    ]
  },
  "tools": {
    "metricsJs": "metrics2.js",
    "capture": "capture.mjs"
  },
  "guard": {
    "bodyClient": "",
    "note": "留空 = 不做本体前后哈希对比（报告里明写 n/a）；要守卫就填本体 client 目录或 %VFX_LOOP_BODY_CLIENT% 模板。"
  },
  "retarget": {
    "note": "默认适配层（v3）。v3 在 v2 上补了三节：target（目标帧怎么来）/ params（白名单怎么来）/ freeze.protocol+urlTemplate（冻帧协议）。最少命令行 = -Adapter 本文件 -Budget N -Out 目录。"
  }
}

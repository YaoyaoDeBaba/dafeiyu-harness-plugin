{
  "_说明": "领域先验区间。role=discriminator 的键必须每条都有判据（治判据缺项）；role=param 的是旋钮区间，用来拦「参数不在合理量级」，不要求有判据。",
  "volumetric-cloud": {
    "sigma_m": {
      "role": "param",
      "range": [
        0.02,
        0.15
      ],
      "unit": "1/m",
      "why": "太小不出暗部，太大一片死黑",
      "source": "natural-disasters Clouds.js:322"
    },
    "ambient_frac": {
      "role": "param",
      "range": [
        0.005,
        0.06
      ],
      "unit": "相对太阳",
      "why": "夜间天光 >6% 会把暗部洗成灰雾",
      "source": "Clouds.js:309-315"
    },
    "lightSteps": {
      "role": "param",
      "range": [
        4,
        8
      ],
      "unit": "步",
      "why": "<4 遮挡不足（整团一起亮），>8 性价比差",
      "source": "Clouds.js:336"
    },
    "powder": {
      "role": "param",
      "range": [
        0.4,
        0.8
      ],
      "unit": "0~1",
      "why": "让受光边读起来是实体而不是棉絮",
      "source": "HZD 2015"
    },
    "cloudDarkFrac": {
      "role": "discriminator",
      "range": [
        0.2,
        0.34
      ],
      "unit": "云掩膜内<0.25 占比",
      "why": "雷云体积是暗的，只有裂缝亮；这是「云像不像云」的主判别量",
      "source": "参考 24 帧实测 25.5%"
    },
    "cloudBrightFrac": {
      "role": "discriminator",
      "range": [
        0.005,
        0.06
      ],
      "unit": "云掩膜内>0.6 占比",
      "why": "亮口只该是少数；超了就是「均匀发亮的雾」",
      "source": "参考 24 帧实测 2.0%"
    }
  }
}